pipeline {

    agent any

    triggers {
        githubPush()
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {

        DOCKER_IMAGE = 'anandhissal1/springmvcsearch'

        SONAR_PROJECT_KEY = 'SpringMVCSearch'
        SONAR_PROJECT_NAME = 'SpringMVCSearch'

        K8S_NAMESPACE = 'springmvc'
        K8S_DEPLOYMENT = 'springmvcsearch'
        K8S_CONTAINER = 'springmvcsearch'

        KUBECONFIG = '/var/lib/jenkins/.kube/config'
    }

    stages {

        stage('Git Checkout') {
            steps {
                echo 'Checking out source code...'

                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir('SpringMVCSearch') {
                    echo 'Building Spring MVC application...'
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('SpringMVCSearch') {
                    echo 'Running SonarQube analysis...'
        
                    script {
                        def scannerHome = tool 'SonarScanner'
        
                        withSonarQubeEnv('SonarQube') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=SpringMVCSearch \
                                -Dsonar.projectName=SpringMVCSearch \
                                -Dsonar.sources=src/main/java \
                                -Dsonar.java.binaries=target/classes
                            """
                        }
                    }
                }
            }
        }
        
        stage('SonarQube Quality Gate') {
            steps {
                echo 'Waiting for SonarQube Quality Gate...'
        
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Gitleaks Scan') {
            steps {

                dir('SpringMVCSearch') {

                    echo 'Running Gitleaks scan...'

                    sh '''
                        gitleaks version

                        gitleaks detect \
                          --source . \
                          --no-banner \
                          --redact
                    '''
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {

                dir('SpringMVCSearch') {

                    echo 'Running Trivy filesystem scan...'

                    sh '''
                        trivy fs \
                          --scanners vuln,misconfig \
                          --severity HIGH,CRITICAL \
                          --exit-code 0 \
                          .
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {

                dir('SpringMVCSearch') {

                    echo "Building Docker image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"

                    sh '''
                        docker build \
                          -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                          .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {

                echo "Scanning Docker image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"

                sh '''
                    trivy image \
                      --severity CRITICAL \
                      --exit-code 1 \
                      ${DOCKER_IMAGE}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Docker Push') {
            steps {

                echo 'Pushing image to DockerHub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                        docker login \
                          -u "$DOCKER_USERNAME" \
                          --password-stdin

                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {

                dir('SpringMVCSearch') {

                    echo 'Deploying application to Kubernetes...'

                    sh '''
                        kubectl get nodes

                        kubectl apply \
                          -f kubernetes/deployment.yaml \
                          -n ${K8S_NAMESPACE}

                        kubectl apply \
                          -f kubernetes/service.yaml \
                          -n ${K8S_NAMESPACE}

                        kubectl set image \
                          deployment/${K8S_DEPLOYMENT} \
                          ${K8S_CONTAINER}=${DOCKER_IMAGE}:${BUILD_NUMBER} \
                          -n ${K8S_NAMESPACE}

                        kubectl rollout status \
                          deployment/${K8S_DEPLOYMENT} \
                          -n ${K8S_NAMESPACE} \
                          --timeout=5m
                    '''
                }
            }
        }
    }

    post {

        success {
            echo """
            ==========================================
            PIPELINE SUCCESSFUL
            ==========================================
            Build Number : ${BUILD_NUMBER}
            Docker Image : ${DOCKER_IMAGE}:${BUILD_NUMBER}
            Deployment   : ${K8S_DEPLOYMENT}
            Namespace    : ${K8S_NAMESPACE}
            ==========================================
            """
        }

        failure {
            echo """
            ==========================================
            PIPELINE FAILED
            ==========================================
            Build Number : ${BUILD_NUMBER}
            Check Jenkins Console Output.
            ==========================================
            """
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
